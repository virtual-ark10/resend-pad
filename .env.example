# pad-kit — environment configuration
# Copy to .env next to boot.sh and fill in. Loaded by boot.sh AND watchdog.sh.
# Values set in .env override the corresponding fields in config.json.

# ---- Resend (required for send / sent list / received) -------------------
# Server-side only — never sent to a browser.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Svix signing secret of your Resend webhook (required to archive webhooks;
# without it /api/webhook rejects everything with 400).
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ---- Pad auth (required) ------------------------------------------------
# The single shared secret the browser sends as X-Pad-Token.
# Generate with: head -c 32 /dev/urandom | base64
PAD_TOKEN=change-me-to-a-long-random-string

# ---- Optional overrides --------------------------------------------------
#PORT=3001
#DATA_DIR=/absolute/path/to/data
#CONFIG_FILE=/absolute/path/to/config.json
#PAD_USE_CASE=outbound           # only if config.json has no useCase
#RATE_PER_MINUTE=60
#MAX_BODY_BYTES=5242880
# Log to a file instead of stdout (leave unset under systemd/journald):
#PAD_LOG=/absolute/path/to/pad.log

# Extra env file to load after .env (shared credentials, e.g. a corpus file):
#EXTRA_ENV_FILE=/home/you/.config/yourbrand/secrets.env

# ---- Caddy route (used by watchdog.sh + add_caddy_route.py) --------------
# Public route prefix the watchdog re-applies if it disappears. Empty = skip.
#ROUTE_PATH=/pad
#CADDY_ADMIN=http://127.0.0.1:2019

# ---- OPTIONAL outreach link minting / blocking (default OFF) -------------
# Leave OUTREACH_ENABLED unset (or 0) and the send path never calls mint/block
# logic at all — sends go straight to Resend.
#OUTREACH_ENABLED=0
#OUTREACH_API_BASE=http://127.0.0.1:3000/api/v1
#OUTREACH_BEARER_TOKEN=
#OUTREACH_STORE_PATH=/absolute/path/to/attribution.json
#OUTREACH_SITE_URL=https://your-site.example
